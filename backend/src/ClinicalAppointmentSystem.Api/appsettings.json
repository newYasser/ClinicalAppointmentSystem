{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Clinic": {
    "TimeZone": "Africa/Cairo"
  },
  "Authentication": {
    "Jwt": {
      "Issuer": "ClinicalAppointmentSystem",
      "Audience": "ClinicalAppointmentSystem.Client",
      "LifetimeMinutes": 60
    }
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:4200" ]
  }
}
